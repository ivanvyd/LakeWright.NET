<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Tenancy contracts for Lakewright.NET.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- TenantContext must only be constructible by something that has checked membership.
         These two assemblies are the resolver and the suite that tests it. Adding a third is a
         security decision, not a build one. -->
    <InternalsVisibleTo Include="Lakewright.Multitenancy" />
    <InternalsVisibleTo Include="Lakewright.TenantIsolation.Tests" />
  </ItemGroup>
</Project>
