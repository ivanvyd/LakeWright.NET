<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <!-- A public accelerator is read as much as it is run, so the XML doc file ships.
         CS1591 is suppressed rather than enforced: with warnings-as-errors it demands a
         comment on ToString() and Parse(), and a comment written to satisfy a compiler
         restates the signature. That is the comment slop this project rejects elsewhere.
         Document what is not obvious; leave the rest bare. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Lock files are what make locked-mode restore in CI mean anything: without
         them a compromised or yanked transitive package changes silently between
         the run that passed review and the run that produced the artifact. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Deterministic output so a release binary can be rebuilt and compared
         against the published artifact. Required for the provenance attestation
         in .github/workflows/release.yml to mean anything. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>LakeWright.NET contributors</Authors>
    <Product>LakeWright.NET</Product>
    <RepositoryUrl>https://github.com/ivanvyd/LakeWright.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ivanvyd/LakeWright.NET</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- nuget.org search reads these. Publishing without them (ADR 0010) would put the packages
         somewhere nobody can find, which was the reason for publishing in the first place. -->
    <PackageTags>databricks;multi-tenancy;saas;unity-catalog;lakehouse;aspnetcore</PackageTags>

    <!-- The release workflow overrides this from the tag, so a package can never claim a
         version the tag does not; this value is what a local `dotnet pack` produces. -->
    <VersionPrefix>2.0.0</VersionPrefix>
    <Copyright>Copyright (c) LakeWright.NET contributors</Copyright>
  </PropertyGroup>

  <!-- Every package that was already public at 1.2.1 is compared with that stable NuGet
       artifact during pack. A new package has no safe baseline until its first stable release;
       it joins this list in its next minor version. This catches binary compatibility breaks
       across the net8/net10 assets without maintaining a second, hand-written API inventory. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'LakeWright.Core' Or '$(MSBuildProjectName)' == 'LakeWright.Databricks' Or '$(MSBuildProjectName)' == 'LakeWright.Embedding' Or '$(MSBuildProjectName)' == 'LakeWright.AspNetCore' Or '$(MSBuildProjectName)' == 'LakeWright.Multitenancy' Or '$(MSBuildProjectName)' == 'LakeWright.AI' Or '$(MSBuildProjectName)' == 'LakeWright.Conversations'">
    <PackageValidationBaselineVersion>1.2.1</PackageValidationBaselineVersion>
    <EnablePackageValidation Condition="$([System.Version]::Parse('$(VersionPrefix)').Major) == $([System.Version]::Parse('$(PackageValidationBaselineVersion)').Major)">true</EnablePackageValidation>
  </PropertyGroup>

  <!-- PackageReadmeFile names the file; it does not put it in the package. Without this, `dotnet
       pack` fails with NU5039 on every packable project — which is how the release workflow would
       have failed on its first run, having never been executed. -->
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
