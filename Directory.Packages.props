<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Databricks">
    <!-- Verified against a live workspace in docs/planning/spike-01-statement-execution.md:
         parameterised statements, EXTERNAL_LINKS and ARROW_STREAM all work. -->
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Microsoft.Azure.Databricks.Client" Version="2.9.3" />
  </ItemGroup>

  <ItemGroup Label="Azure SDK (net10.0)" Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageVersion Include="Azure.Core" Version="1.60.0" />
  </ItemGroup>

  <ItemGroup Label="Azure SDK (net8.0 floor)" Condition="'$(TargetFramework)' == 'net8.0'">
    <!-- The Databricks client ships a net8.0 asset against Azure.Core 1.44.1. Newer Azure Core
         versions pull Extensions 10, which cannot form a stock net8 consumer graph. Azure
         Identity stays a net10-only dependency in this repository. -->
    <PackageVersion Include="Azure.Core" Version="1.44.1" />
  </ItemGroup>

  <ItemGroup Label="Persistence">
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Label="Extensions">
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />
    <PackageVersion Include="OpenAI" Version="2.12.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <!-- Pinned above the transitive 2.0.0 that Microsoft.AspNetCore.OpenApi resolves:
         GHSA-v5pm-xwqc-g5wc is high severity and patched in 2.7.5. The vulnerable-package
         gate in CI caught it, which is the whole reason that gate exists. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
    <!-- Pinned above the transitive 2025.1.0 that the Databricks SDK resolves:
         GHSA-q939-rpr3-3284 is high severity (CVE-2026-48798) and patched in
         2026.0.0. The vulnerable-package gate in CI caught it, which is the
         whole reason that gate exists. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <!-- Pinned for the net8.0 polyfill of TimeProvider/TimeProvider.System, which the runtime
         does not ship. .NET 8 is an LTS the embedding package explicitly multi-targets so a
         non-ASP.NET consumer on a lower LTS can adopt it; the BCL has the type on net8.0 but
         only via this shim. The net10.0 build does not consume this package. -->
    <PackageVersion Include="Microsoft.Bcl.TimeProvider" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup Label="Extensions (net10.0)" Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Extensions (net8.0 floor)" Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <!-- xUnit 4 defaults to Microsoft Testing Platform v2. This repository intentionally keeps
         the VSTest pipeline for TRX and coverlet compatibility, so use the official opt-out
         package until the test infrastructure is migrated as one deliberate change. -->
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <!-- Pinned above the transitive SSH.NET version resolved by Testcontainers. Older versions are
         GHSA-q939-rpr3-3284 (high): ScpClient's recursive download writes wherever a malicious
         server's filenames point. Patched in 2026.0.0. Keep the direct pin until Testcontainers
         resolves 2026.0.0 itself. -->
    <!-- SSH.NET 2026.0.0 is pinned once in the Extensions group above (for the Databricks SDK
         transitive); Central Package Management requires a single PackageVersion entry, and the
         version is the same. -->
    <PackageVersion Include="WireMock.Net" Version="2.15.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <!-- The load harness (scripts/load) reads pg_stat_activity to track connection-pool
         utilisation. Same major.minor as the existing Npgsql.EntityFrameworkCore.PostgreSQL
         pin; pulling the bare ADO.NET package in addition is the only way to get the raw
         connection from outside the EF Core model. -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- The XPlat Code Coverage data collector produces nothing without this package, silently:
         the run still passes and still reports a count rather than a proportion. LakeWright.AI
         shipped with only its line transform covered by a test CI ran, and a review caught that
         rather than a number. -->
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <!-- Property-based tests over the one value that reaches Databricks unparameterised: a Unity
         Catalog identifier. Example-based tests check the cases someone thought of; this checks
         the ones nobody did, which for an injection guard is the point. -->
    <PackageVersion Include="FsCheck" Version="3.3.4" />
  </ItemGroup>

  <ItemGroup Label="Observability (sample only)">
    <!-- The library publishes plain System.Diagnostics instruments and takes no OpenTelemetry
         dependency. These versions are pinned for the sample's opt-in OTel wiring; an adopter
         picks their own exporter and version, which is the whole point of leaving the library
         out of this decision. -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
  </ItemGroup>

</Project>
