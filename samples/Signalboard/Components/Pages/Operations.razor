@page "/operations"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@inject TenantWorkspace Workspace
@inject PersistentComponentState PageState

<PageTitle>Operations — Signalboard</PageTitle>

@if (_view is null)
{
    <p>Loading.</p>
}
else
{
    <h1>@_view.Organization</h1>

    <p class="scope">
        Everything below belongs to @_view.Organization. There is no query in this page that
        could return anything else: the operation store takes a resolved tenant and filters on it.
    </p>

    <form class="start" @onsubmit="StartAsync" @formname="start-operation">
        <label for="kind">Kind</label>
        <select id="kind" @bind="_kind">
            <option value="analysis">analysis</option>
            <option value="export">export</option>
        </select>
        <button type="submit" disabled="@(_starting || !_interactive || !_view.CanStart)">Start</button>
        @if (!_view.CanStart)
        {
            <span class="denied">
                You are a @_view.Role. Starting work needs Member or above.
            </span>
        }
        else if (!_interactive)
        {
            <span class="hint">Connecting.</span>
        }
    </form>

    @if (_error is not null)
    {
        <p class="denied" role="alert">@_error</p>
    }

    @if (_view.Operations.Count == 0)
    {
        <p>Nothing yet. Start one.</p>
    }
    else
    {
        <table class="operations">
            <thead>
                <tr><th>Started</th><th>Kind</th><th>State</th><th>By</th><th>Address</th></tr>
            </thead>
            <tbody>
                @foreach (var operation in _view.Operations)
                {
                    <tr>
                        <td>@operation.CreatedAt.ToLocalTime().ToString("HH:mm:ss")</td>
                        <td>@operation.Kind</td>
                        <td><span class="state @operation.State.ToString().ToLowerInvariant()">@operation.State</span></td>
                        <td>@DemoTenants.NameOf(operation.PrincipalId)</td>
                        <td class="address"><code>@_view.AddressOf(operation.Id)</code></td>
                    </tr>
                }
            </tbody>
        </table>

        <p class="hint">
            Copy an address and ask for it as someone from the other organization — a header is
            enough: <code>curl -i http://localhost:8080&lt;address&gt; -H "X-Demo-User: demo|bob"</code>.
            You get 404. Not 403 — that would confirm it exists.
        </p>
    }
}

@code {
    private const string StateKey = nameof(Operations);

    private DashboardView? _view;
    private TenantWorkspace.Scope? _scope;
    private string _kind = "analysis";
    private bool _interactive;
    private bool _starting;
    private string? _error;
    private readonly CancellationTokenSource _closed = new();
    private PersistingComponentStateSubscription _persisting;

    /// <summary>
    /// Renders from prerendered state when there is any, and refreshes behind it.
    /// </summary>
    /// <remarks>
    /// This runs twice per visit: once while prerendering, once when the circuit starts. Without
    /// the handover the second pass begins with nothing, so every visitor saw the page, then
    /// "Loading.", then the page again. Prerendering also queried the database for a result that
    /// was then thrown away.
    ///
    /// Only the view crosses over. <see cref="TenantWorkspace.Scope"/> holds a
    /// <c>TenantContext</c>, which exists precisely because membership was checked, and shipping
    /// one through the client would make it a claim again.
    /// </remarks>
    protected override async Task OnInitializedAsync()
    {
        _persisting = PageState.RegisterOnPersisting(Persist);

        if (PageState.TryTakeFromJson<DashboardView>(StateKey, out var prerendered))
        {
            _view = prerendered;
        }

        _scope = await Workspace.CurrentAsync(_closed.Token);
        await RefreshAsync();

        _ = PollAsync();
    }

    private Task Persist()
    {
        if (_view is not null) { PageState.PersistAsJson(StateKey, _view); }
        return Task.CompletedTask;
    }

    /// <remarks>
    /// Runs only once the circuit is live, which is what makes it the signal that the page is
    /// interactive. The prerendered pass shows the same button, and a click on it goes nowhere
    /// because no circuit exists yet to receive the event — so it stays disabled until this fires.
    /// </remarks>
    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || _interactive) { return; }

        _interactive = true;
        StateHasChanged();
    }

    private async Task PollAsync()
    {
        // Operations finish in the background, so the page has to ask. This polling is the only
        // reason the page takes a circuit instead of rendering once as Static SSR.
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));

        try
        {
            while (await timer.WaitForNextTickAsync(_closed.Token))
            {
                await RefreshAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // The visitor navigated away.
        }
    }

    private async Task RefreshAsync()
    {
        if (_scope is null) { return; }

        _view = new DashboardView(
            _scope.Organization,
            _scope.Role.ToString(),
            _scope.CanStart,
            _scope.Tenant.TenantId.Value,
            await Workspace.RecentAsync(_scope, _closed.Token));
    }

    private async Task StartAsync()
    {
        if (_scope is null || _starting) { return; }

        _starting = true;
        _error = null;

        try
        {
            await Workspace.StartAsync(_scope, _kind, _closed.Token);
            await RefreshAsync();
        }
        catch (TenantWorkspace.RoleDeniedException e)
        {
            // The same refusal the API answers with 403, surfaced where the visitor is looking.
            _error = e.Message;
        }
        finally
        {
            _starting = false;
        }
    }

    public void Dispose()
    {
        _persisting.Dispose();
        _closed.Cancel();
        _closed.Dispose();
    }

    /// <summary>What the page draws, and the only thing it hands from prerender to the circuit.</summary>
    private sealed record DashboardView(
        string Organization,
        string Role,
        bool CanStart,
        Guid TenantId,
        IReadOnlyList<OperationRow> Operations)
    {
        public string AddressOf(Guid operationId) =>
            $"/organizations/{TenantId}/operations/{operationId}";
    }
}
