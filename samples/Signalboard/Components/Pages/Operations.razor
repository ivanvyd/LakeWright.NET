@page "/operations"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@inject TenantWorkspace Workspace

<PageTitle>Operations — Signalboard</PageTitle>

@if (_workspace is null)
{
    <p>Loading.</p>
}
else
{
    <h1>@_workspace.Organization</h1>

    <p class="scope">
        Everything below belongs to @_workspace.Organization. There is no query in this page that
        could return anything else: the operation store takes a resolved tenant and filters on it.
    </p>

    <form class="start" @onsubmit="StartAsync" @formname="start-operation">
        <label for="kind">Kind</label>
        <select id="kind" @bind="_kind">
            <option value="analysis">analysis</option>
            <option value="export">export</option>
        </select>
        <button type="submit" disabled="@(_starting || !_workspace.CanStart)">Start</button>
        @if (!_workspace.CanStart)
        {
            <span class="denied">
                You are a @_workspace.Role. Starting work needs Member or above.
            </span>
        }
    </form>

    @if (_error is not null)
    {
        <p class="denied" role="alert">@_error</p>
    }

    @if (_operations.Count == 0)
    {
        <p>Nothing yet. Start one.</p>
    }
    else
    {
        <table class="operations">
            <thead>
                <tr><th>Started</th><th>Kind</th><th>State</th><th>By</th><th>Address</th></tr>
            </thead>
            <tbody>
                @foreach (var operation in _operations)
                {
                    <tr>
                        <td>@operation.CreatedAt.ToLocalTime().ToString("HH:mm:ss")</td>
                        <td>@operation.Kind</td>
                        <td><span class="state @operation.State.ToString().ToLowerInvariant()">@operation.State</span></td>
                        <td>@DemoTenants.NameOf(operation.PrincipalId)</td>
                        <td><code>@_workspace.AddressOf(operation.Id)</code></td>
                    </tr>
                }
            </tbody>
        </table>

        <p class="hint">
            Copy an address and ask for it as someone from the other organization — a header is
            enough: <code>curl -i http://localhost:8080&lt;address&gt; -H "X-Demo-User: demo|bob"</code>.
            You get 404. Not 403 — that would confirm it exists.
        </p>
    }
}

@code {
    private readonly List<OperationRow> _operations = [];
    private TenantWorkspace.Scope? _workspace;
    private string _kind = "analysis";
    private bool _starting;
    private string? _error;
    private readonly CancellationTokenSource _closed = new();

    protected override async Task OnInitializedAsync()
    {
        _workspace = await Workspace.CurrentAsync(_closed.Token);
        await RefreshAsync();
        _ = PollAsync();
    }

    private async Task PollAsync()
    {
        // Operations finish in the background, so the page has to ask. This polling is the only
        // reason the page takes a circuit instead of rendering once as Static SSR.
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));

        try
        {
            while (await timer.WaitForNextTickAsync(_closed.Token))
            {
                await RefreshAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // The visitor navigated away.
        }
    }

    private async Task RefreshAsync()
    {
        if (_workspace is null) { return; }

        _operations.Clear();
        _operations.AddRange(await Workspace.RecentAsync(_workspace, _closed.Token));
    }

    private async Task StartAsync()
    {
        if (_workspace is null || _starting) { return; }

        _starting = true;
        _error = null;

        try
        {
            await Workspace.StartAsync(_workspace, _kind, _closed.Token);
            await RefreshAsync();
        }
        catch (TenantWorkspace.RoleDeniedException e)
        {
            // The same refusal the API answers with 403, surfaced where the visitor is looking.
            _error = e.Message;
        }
        finally
        {
            _starting = false;
        }
    }

    public void Dispose()
    {
        _closed.Cancel();
        _closed.Dispose();
    }
}
