@inherits LayoutComponentBase

<a class="skip-link" href="#main-content">Skip to content</a>

<header class="site-header">
    <div class="nav-shell">
        <a class="brand" href="/" aria-label="LakeWright.NET home">
            <BrandMark />
            <span>lakewright<span class="brand-dot">.net</span></span>
        </a>
        <nav aria-label="Primary navigation">
            <a class="nav-section" href="/#how-it-works">Why LakeWright</a>
            <a class="nav-section" href="/#proof">The sample</a>
            <a class="nav-section" href="https://github.com/ivanvyd/LakeWright.NET/tree/main/docs">Docs <span aria-hidden="true">↗</span></a>
            <AuthorizeView>
                <Authorized>
                    <a href="/operations">Signalboard</a>
                    <form method="post" action="/signout">
                        <AntiforgeryToken />
                        <button type="submit" class="nav-link">Sign out</button>
                    </form>
                </Authorized>
            </AuthorizeView>
            <a class="nav-github" href="https://github.com/ivanvyd/LakeWright.NET">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.87c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03A9.6 9.6 0 0 1 12 6.78c.85 0 1.71.11 2.51.34 1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.79c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" /></svg>
                GitHub <span aria-hidden="true">↗</span>
            </a>
        </nav>
    </div>
</header>

<main id="main-content" tabindex="-1">@Body</main>

<footer class="site-footer">
    <div class="footer-shell">
        <div>
            <a class="brand" href="/"><BrandMark /><span>lakewright<span class="brand-dot">.net</span></span></a>
            <p>Customer-facing .NET analytics on Databricks.</p>
        </div>
        <nav class="footer-links" aria-label="Project links">
            <a href="https://github.com/ivanvyd/LakeWright.NET/tree/main/docs">Documentation</a>
            <a href="https://www.nuget.org/packages/LakeWright.AspNetCore/2.0.0/">NuGet</a>
            <a href="https://github.com/ivanvyd/LakeWright.NET/blob/main/CONTRIBUTING.md">Contributing</a>
            <a href="https://github.com/ivanvyd/LakeWright.NET/blob/main/LICENSE">Apache 2.0</a>
        </nav>
        <p class="footer-note">Independent open-source project. Not affiliated with Databricks, Inc. or Microsoft Corporation.</p>
    </div>
</footer>
