<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <Description>Signalboard: the sample product that proves the LakeWright.NET architecture.</Description>
    <IsPackable>false</IsPackable>
    <UserSecretsId>lakewright-signalboard</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Core" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <!-- The OpenTelemetry wiring is opt-in and lives in the sample, not the library. The
         library publishes plain System.Diagnostics instruments; this is the OTel SDK that
         subscribes to them. -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\LakeWright.AspNetCore\LakeWright.AspNetCore.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\docs\images\lakewright-social-preview.png"
             Link="wwwroot\images\lakewright-social-preview.png"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\images\signalboard-dashboard.png"
             Link="wwwroot\images\signalboard-dashboard.png"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\images\signalboard-viewer-denied.png"
             Link="wwwroot\images\signalboard-viewer-denied.png"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\images\signalboard-other-tenant.png"
             Link="wwwroot\images\signalboard-other-tenant.png"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
